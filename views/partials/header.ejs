<header>
  <div class="header-top">
    <span class="siteName">
      <a href="/" title="Return to home page"><span class="letter-c">C</span><span class="letter-s">S</span><span class="letter-e">E</span> <span class="motors">Motors</span></a>
    </span>
    <% if (locals.loggedin) { %>
      <a href="/account/" title="Go to account management">Welcome <%= locals.accountData.account_firstname %></a>
      <a href="/account/logout" title="Click to log out">Logout</a>
    <% } else { %>
      <a href="/account/login" class="my_account" title="Click to log in">My Account</a>
    <% } %>
  </div>
</header>
