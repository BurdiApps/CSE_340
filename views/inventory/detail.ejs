<h1><%= title %></h1>
<%- detail %>

<hr>
<h2>Customer Reviews</h2>
<%- messages() %>

<% if (reviews && reviews.length > 0) { %>
  <div class="reviews-list">
    <% reviews.forEach(function(review) { %>
      <div class="review-item">
        <div class="review-header">
          <strong class="review-author"><%= review.account_firstname %> <%= review.account_lastname.charAt(0) %>.</strong>
          <span class="review-date"><%= new Date(review.review_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        </div>
        <p class="review-text"><%= review.review_text %></p>
        <% if (locals.loggedin && locals.accountData.account_id === review.account_id) { %>
          <div class="review-actions">
            <a href="/review/edit/<%= review.review_id %>">Edit</a> |
            <a href="/review/delete/<%= review.review_id %>">Delete</a>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p class="no-reviews">No reviews yet. Be the first to review this vehicle!</p>
<% } %>

<% if (locals.loggedin) { %>
  <h3>Add Your Review</h3>
  <form action="/review/add" method="post" class="review-form">
    <label for="review_text"><strong>Your Review</strong></label>
    <textarea id="review_text" name="review_text" rows="4" required minlength="5" placeholder="Share your thoughts about this vehicle..."></textarea>
    <input type="hidden" name="inv_id" value="<%= inv_id %>">
    <button type="submit">Submit Review</button>
  </form>
<% } else { %>
  <p><a href="/account/login">Log in</a> to leave a review.</p>
<% } %>
