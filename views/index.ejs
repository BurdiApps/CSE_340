<h1>Welcome to <span class="letter-c">C</span><span class="letter-s">S</span><span class="letter-e">E</span> <span class="motors">Motors</span>!</h1>
<%- messages() %>

<section class="hero reveal">
  <div class="hero-container">
    <div class="hero-image">
      <img src="/images/vehicles/delorean.jpg" alt="DMC Delorean" />
      <div class="hero-overlay">
        <h2 class="hero-title">DMC Delorean</h2>
        <ul class="hero-features">
          <li>3 Cup holders</li>
          <li>Superman doors</li>
          <li>Fuzzy dice</li>
        </ul>
        <a href="#" class="own-today">Own Today</a>
      </div>
    </div>
  </div>
</section>

<section class="main-content">
  <div class="reviews reveal">
    <h2>DMC Delorean Reviews</h2>
    <ul>
      <li>"So fast it's almost like traveling in time." (4/5)</li>
      <li>"Coolest ride on the road." (4/5)</li>
      <li>"I'm feeling McFly!" (5/5)</li>
      <li>"The most futuristic ride of our day." (4.5/5)</li>
      <li>"80's livin and I love it!" (5/5)</li>
    </ul>
  </div>

  <div class="upgrades reveal">
    <h2>Delorean Upgrades</h2>
    <div class="upgrade-grid">
      <div class="upgrade-item">
        <a href="#">
          <img src="/images/upgrades/flux-cap.png" alt="" loading="lazy" />
          <p>Flux Capacitor</p>
        </a>
      </div>
      <div class="upgrade-item">
        <a href="#">
          <img src="/images/upgrades/flame.jpg" alt="" loading="lazy" />
          <p>Flame Decals</p>
        </a>
      </div>
      <div class="upgrade-item">
        <a href="#">
          <img src="/images/upgrades/bumper_sticker.jpg" alt="" loading="lazy" />
          <p>Bumper Stickers</p>
        </a>
      </div>
      <div class="upgrade-item">
        <a href="#">
          <img src="/images/upgrades/hub-cap.jpg" alt="" loading="lazy" />
          <p>Hub Caps</p>
        </a>
      </div>
    </div>
  </div>
</section>